# Скопируйте в .env и вставьте свой ключ:
#   cp .env.example .env

# --- Вариант 1: Groq (бесплатный tier, рекомендуется для переводчика) ---
# Ключ: https://console.groq.com/keys
VITE_OPENAI_API_KEY=gsk_your_groq_key_here
VITE_OPENAI_API_BASE_URL=https://api.groq.com/openai/v1
VITE_AI_PROVIDER=openai
VITE_AI_MODEL=llama-3.3-70b-versatile

# --- Вариант 2: DeepSeek ---
# VITE_OPENAI_API_KEY=sk_your_deepseek_key_here
# VITE_OPENAI_API_BASE_URL=https://api.deepseek.com/v1
# VITE_AI_PROVIDER=openai
# VITE_AI_MODEL=deepseek-chat

